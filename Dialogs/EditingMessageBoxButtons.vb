'''<summary>Specifies constants defining which buttons to display in an editing dialog box.</summary>
Public Enum EditingMessageBoxButtons
    '''<summary>The dialog box contains the OK button.</summary>
    OK = 0
    '''<summary>The dialog box contains the OK and Cancel buttons.</summary>
    OKCancel = 1
    '''<summary>The dialog box contains the Abort, Retry, and Ignore buttons.</summary>
    AbortRetryIgnore = 2
    '''<summary>The dialog box contains the Yes, No, and Cancel buttons.</summary>
    YesNoCancel = 3
    '''<summary>The dialog box contains the Yes and No buttons.</summary>
    YesNo = 4
    '''<summary>The dialog box contains the Retry and Cancel buttons.</summary>
    RetryCancel = 5
    '''<summary>The dialog box contains the OK, Cancel, and Delete buttons.</summary>
    OKCancelDelete = 6
End Enum
