'''<summary>Determines what scroll bars on a <see cref="ScrollableControl"/> can become visible as needed.</summary>
Public Enum AutoScrollMode
    '''<summary>No scroll bars will be visible.</summary>
    None = 0
    '''<summary>Only the horizontal scroll bar will be visible as needed.</summary>
    Horizontal = 1
    '''<summary>Only the vertical scroll bar will be visible as needed.</summary>
    Vertical = 2
    '''<summary>Both scroll bars will be visible as needed.</summary>
    All = 3
End Enum
