'''<summary>Represents a direction.</summary>
Public Enum Direction
    '''<summary>No direction.</summary>
    None = 0
    '''<summary>Object goes up.</summary>
    Up = 1
    '''<summary>Object goes left.</summary>
    Left = 2
    '''<summary>Object goes down.</summary>
    Down = 3
    '''<summary>Object goes right.</summary>
    Right = 4
End Enum
