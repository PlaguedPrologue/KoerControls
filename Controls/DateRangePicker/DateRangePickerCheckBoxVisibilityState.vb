'''<summary>Specifies the checkboxes visible for a DateRangePicker.</summary>
Public Enum DateRangePickerCheckBoxVisibilityState
    '''<summary>No checkboxes are visible in the DateRangePicker.</summary>
    None = 0
    '''<summary>Only the StartDate checkbox is visible in the DateRangePicker</summary>
    StartDate = 1
    '''<summary>Only the EndDate checkbox is visible in the DateRangePicker</summary>
    EndDate = 2
    '''<summary>Both the StartDate and EndDate checkboxes are visible in the DateRangePicker</summary>
    DateRange = 3
End Enum
