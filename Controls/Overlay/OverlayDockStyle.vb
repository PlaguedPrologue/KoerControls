'''<summary>Specifies the position and manner in which an overlay is docked.</summary>
Public Enum OverlayDockStyle
    '''<summary>The overlay's top edge is docked to the top of its host.</summary>
    Top = 1
    '''<summary>The overlay's bottom edge is docked to the bottom of its host.</summary>
    Bottom = 2
    '''<summary>The overlay's left edge is docked to the left of its host.</summary>
    Left = 3
    '''<summary>The overlay's right edge is docke to the right of its host.</summary>
    Right = 4
End Enum
